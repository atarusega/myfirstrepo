# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Юзернейм бота без @ (нужен для ссылок импорта)
BOT_USERNAME=coverbot_test_bot
# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111
# Ключ Anthropic API. Без ключа бот работает на простом разборе запросов без нейросети
ANTHROPIC_API_KEY=
# Необязательно: адрес прокси к Anthropic API, если сервер в неподдерживаемом регионе
ANTHROPIC_BASE_URL=
LLM_MODEL=claude-haiku-4-5-20251001

# Значения ниже — для запуска на своём компьютере. В docker-compose (облако) они заменяются
# на Postgres и Redis автоматически, здесь ничего менять не нужно.
# База — файл coverbot.db в папке проекта
DATABASE_URL=sqlite+aiosqlite:///./coverbot.db
# Хранилище состояний диалогов. Пусто — в памяти: незаконченные анкеты сбрасываются при перезапуске бота.
# Если установлен Redis: redis://localhost:6379/0
REDIS_URL=
