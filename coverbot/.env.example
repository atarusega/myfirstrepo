# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Юзернейм бота без @ (нужен для ссылок импорта)
BOT_USERNAME=coverbot_test_bot
# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111
# Ключ Anthropic API. Без ключа бот работает на простом разборе запросов без нейросети
ANTHROPIC_API_KEY=
# Необязательно: адрес прокси к Anthropic API, если сервер в неподдерживаемом регионе
ANTHROPIC_BASE_URL=
LLM_MODEL=claude-haiku-4-5-20251001
# В docker-compose подставляется автоматически. Для локального запуска без Docker:
# DATABASE_URL=sqlite+aiosqlite:///./coverbot.db
DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/bot
# Хранилище состояний диалогов. В docker-compose подставляется автоматически.
# Пусто — хранится в памяти, незаконченные анкеты сбрасываются при перезапуске бота
REDIS_URL=redis://redis:6379/0
